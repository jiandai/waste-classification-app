# API Configuration
# Base URL for the waste classification API
# Default: https://waste-classification-app.onrender.com
# You can override this for different environments (development, staging, production)
EXPO_PUBLIC_API_URL=https://waste-classification-app.onrender.com

# Expo Development Server Configuration
# 
# Uncomment and set your local IP address if Expo is not detecting it correctly
# Find your IP address:
#   - Mac/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
#   - Windows: ipconfig (look for IPv4 Address)
# REACT_NATIVE_PACKAGER_HOSTNAME=10.0.0.132
